        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor P as Paciente\n    participant S as Sistema VITTAS\n    participant F as Fonte de Disponibilidade\n\n    alt UC08 – Pesquisar serviço de saúde\n        P-&gt;&gt;S: Acessa a busca\n        P-&gt;&gt;S: Informa serviço/instituição\n        P-&gt;&gt;S: Define filtros (quando necessário)\n        S-&gt;&gt;S: Processa critérios\n        alt Resultados encontrados\n            S--&gt;&gt;P: Apresenta resultados compatíveis\n        else Nenhum resultado\n            S--&gt;&gt;P: Informa que nenhum resultado foi encontrado\n        end\n\n    else UC09 – Busca orientada por necessidade\n        P-&gt;&gt;S: Informa necessidade de atendimento\n        S-&gt;&gt;S: Identifica critérios estruturados\n        S-&gt;&gt;S: Cruza critérios com dados disponíveis\n        alt Alternativas encontradas\n            S--&gt;&gt;P: Apresenta alternativas de atendimento\n        else Sem alternativas\n            S--&gt;&gt;P: Informa que não foram encontradas opções\n        end\n    end\n\n    Note over P,S: Interligação: seleção leva à consulta de disponibilidade\n    P-&gt;&gt;S: Seleciona um resultado/alternativa\n    S--&gt;&gt;P: Apresenta informações da instituição/serviço\n\n    Note over P,F: UC10 – Consultar disponibilidade\n    P-&gt;&gt;S: Solicita disponibilidade\n    S-&gt;&gt;F: Consulta horários disponíveis\n\n    alt Fonte disponível\n        F--&gt;&gt;S: Retorna horários\n        S-&gt;&gt;S: Verifica origem da disponibilidade\n\n        alt Horários disponíveis\n            S--&gt;&gt;P: Apresenta horários disponíveis\n            P-&gt;&gt;S: Seleciona um horário\n        else Sem horários\n            S--&gt;&gt;P: Informa indisponibilidade\n        end\n\n    else Fonte indisponível\n        S--&gt;&gt;P: Informa que a disponibilidade não pôde ser atualizada\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="92zZYLTlFunj8II8gW-5-43">
